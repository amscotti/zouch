[Unit]
Description=Zouch document database
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zouch
Group=zouch
EnvironmentFile=-/etc/zouch.env
ExecStart=/usr/local/bin/zouch serve /var/lib/zouch 5985
Restart=on-failure
RestartSec=2
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/zouch

[Install]
WantedBy=multi-user.target
